CONFIG_TARGET_esp32p4rv32=y
CONFIG_TARGET_esp32p4rv32_generic=y
CONFIG_TARGET_esp32p4rv32_generic_Default=y
CONFIG_PACKAGE_apk-mbedtls=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_esp32p4-demo=m
CONFIG_PACKAGE_libcurl=y
