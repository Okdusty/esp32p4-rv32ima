#!/bin/sh

port=${1:-5000}
width=${2:-256}
height=${3:-144}

# The console's show/hide cursor sequences (setterm --cursor on/off).
restore_console()
{
	printf '\033[?25h' > /dev/tty0 2>/dev/null || true
}

trap restore_console EXIT HUP INT TERM
printf '\033[?25l' > /dev/tty0 2>/dev/null || true
printf 'Waiting for %sx%s RGB565 video on TCP port %s...\n' \
	"$width" "$height" "$port"
nc -l -p "$port" | fbstream "$width" "$height"
