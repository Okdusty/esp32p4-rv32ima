#!/bin/sh

export PATH=/usr/sbin:/usr/bin:/sbin:/bin
export HOME=/root
export TERM=linux

mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mkdir -p /dev/pts /tmp/run /tmp/lock /tmp/log /etc/dropbear
mount -t devpts devpts /dev/pts -o mode=620,ptmxmode=666
ln -sf pts/ptmx /dev/ptmx

mount -o remount,size=16M /
printf '%s\n' esp32p4-openwrt >/proc/sys/kernel/hostname
ip link set lo up

if ip link show eth0 >/dev/null 2>&1; then
  ip link set eth0 up
  ip addr flush dev eth0
  ip addr add 192.168.1.220/24 dev eth0
  ip route replace default via 192.168.1.1 dev eth0
  printf '%s\n' 'nameserver 1.1.1.1' >/etc/resolv.conf
fi

dropbear_status=disabled
if [ "$(sed -n '1p' /etc/rv32-dropbear 2>/dev/null)" = 1 ]; then
  if [ ! -s /etc/dropbear/dropbear_ed25519_host_key ]; then
    dropbearkey -t ed25519 -f /etc/dropbear/dropbear_ed25519_host_key \
      >/dev/null 2>&1
  fi
  if /usr/sbin/dropbear -E -p 22 \
    -r /etc/dropbear/dropbear_ed25519_host_key; then
    dropbear_status=enabled
  else
    printf '%s\n' 'warning: Dropbear failed to start' >&2
  fi
fi

console_service=$(sed -n '1p' /etc/rv32-console 2>/dev/null)
case "$console_service" in
console-mux) console_program=/usr/sbin/console-mux ;;
display-shell) console_program=/usr/sbin/display-shell ;;
*)
  printf '%s\n' 'warning: invalid /etc/rv32-console; using display-shell' >&2
  console_service=display-shell
  console_program=/usr/sbin/display-shell
  ;;
esac
if [ ! -x "$console_program" ]; then
  printf 'warning: %s is unavailable; using display-shell\n' "$console_program" >&2
  console_service=display-shell
  console_program=/usr/sbin/display-shell
fi

printf '\nOpenWrt RV32 on ESP32-P4 (console: %s, Dropbear: %s)\n\n' \
  "$console_service" "$dropbear_status"
exec "$console_program"
