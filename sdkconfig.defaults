CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

CONFIG_SPI_MASTER_IN_IRAM=y
CONFIG_SPI_MASTER_ISR_IN_IRAM=y
CONFIG_GPIO_CTRL_FUNC_IN_IRAM=y

CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="32MB"

CONFIG_TASK_WDT=n

# ESP32-P4 <-> onboard ESP32-C6: SDIO4 GPIO14-19, reset GPIO54.
CONFIG_SLAVE_IDF_TARGET_ESP32C6=y
CONFIG_ESP_HOSTED_CP_TARGET_ESP32C6=y
CONFIG_ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD=y
CONFIG_ESP_HOSTED_SDIO_HOST_INTERFACE=y
CONFIG_ESP_HOSTED_SDIO_SLOT_1=y
CONFIG_ESP_HOSTED_SDIO_4_BIT_BUS=y
CONFIG_ESP_HOSTED_SDIO_CLOCK_FREQ_KHZ=40000

CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_360=y
CONFIG_CACHE_L2_CACHE_128KB=y
CONFIG_CACHE_L2_CACHE_LINE_64B=y
CONFIG_WIFI_RMT_STATIC_RX_BUFFER_NUM=16
CONFIG_WIFI_RMT_DYNAMIC_RX_BUFFER_NUM=64
CONFIG_WIFI_RMT_DYNAMIC_TX_BUFFER_NUM=64
CONFIG_WIFI_RMT_TX_BA_WIN=32
CONFIG_WIFI_RMT_RX_BA_WIN=32

CONFIG_ESP_HOSTED_MEM_MONITOR=n
CONFIG_ESP_HOSTED_ENABLE_ITWT=n
CONFIG_ESP_HOSTED_CLI_ENABLED=n
CONFIG_ESP_HOSTED_ENABLE_PEER_DATA_TRANSFER=y
# A missing/mismatched C6 must not reboot the P4 or interrupt Linux/display.
CONFIG_ESP_HOSTED_TRANSPORT_RESTART_ON_FAILURE=n
# Preserve scarce P4 internal RAM for task stacks and interrupt-time work.
CONFIG_ESP_HOSTED_MEMPOOL_PREFER_SPIRAM=y

CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384

# ESP-Hosted events arrive through sys_evt with a deep RPC/SDIO call chain.
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096

# The onboard panel remains the default, but can be disabled cleanly for a
# headless build with CONFIG_RV32_ST7703_DISPLAY=n.
CONFIG_RV32_ST7703_DISPLAY=y

# Default station used by the RV32 virtio-net bridge.
CONFIG_RV32_WIFI_SSID="Java"
CONFIG_RV32_WIFI_PASSWORD="baglanartik31"
