#!/bin/sh

set -eu

game_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
save_dir=$game_dir/save

mkdir -p "$save_dir"

hide_cursor() {
    printf '\033[?25l' > /dev/tty0 2>/dev/null || true
}

show_cursor() {
    printf '\033[?25h' > /dev/tty0 2>/dev/null || true
}

trap show_cursor EXIT INT TERM
hide_cursor

cd "$save_dir"
"$game_dir/doom" \
    -iwad "$game_dir/freedoom1.wad" \
    -gfxmode rgb565 \
    -nosound \
    -nomusic \
    "$@"
